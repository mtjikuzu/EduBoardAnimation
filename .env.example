# =============================================================================
# EduWhiteboard Environment Configuration
# =============================================================================
# Copy to .env and fill in all required values before running docker compose up
#
#   cp .env.example .env
#   docker compose up -d
# =============================================================================

# --- Database ---
POSTGRES_USER=eduwb
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=eduwb

# --- Redis ---
REDIS_PASSWORD=change-me-redis-password

# --- MinIO Object Storage ---
MINIO_ACCESS_KEY=eduwb
MINIO_SECRET_KEY=change-me-minio-secret

# --- Clerk Authentication (https://clerk.com) ---
# Leave empty to use dev-mode auth (X-Dev-Creator-Id header)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# --- OpenAI (storyboard generation) ---
# Required for production storyboard generation. Leave empty to use mock planner.
OPENAI_API_KEY=

# --- Kokoro TTS ---
# All defaults — runs 100% locally. Override only for voice/model selection.
# KOKORO_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
# KOKORO_VOICE=af_heart
# KOKORO_DTYPE=q8
# KOKORO_DEVICE=cpu

# --- Polar Commerce (https://polar.sh) ---
# Required for real credit purchases
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# --- YouTube Publishing (https://console.cloud.google.com) ---
# Required for real YouTube uploads
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Server ---
API_PORT=5000
FRONTEND_PORT=5173
NODE_ENV=production
LOG_LEVEL=info
