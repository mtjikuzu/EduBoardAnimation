# EduWhiteboard API server — Dockerfile
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

# Install system dependencies for Chromium and FFmpeg
RUN apk add --no-cache chromium ffmpeg espeak font-noto font-noto-cjk fontconfig

ENV CHROMIUM_PATH=/usr/bin/chromium-browser
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Copy entire workspace
COPY . .

# Install dependencies (skip scripts for native modules - they'll fail in CI)
RUN pnpm install --frozen-lockfile --ignore-scripts 2>/dev/null; \
    pnpm install --frozen-lockfile 2>&1 | tail -5 || true

# Build the API server
RUN pnpm --filter @workspace/api-server run build

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:5000/api/healthz || exit 1

CMD ["node", "--enable-source-maps", "artifacts/api-server/dist/index.mjs"]
