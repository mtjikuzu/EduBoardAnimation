# EduWhiteboard Frontend — Dockerfile (multi-stage)
FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

COPY . .
RUN pnpm install --frozen-lockfile 2>&1 | tail -3

# Build the frontend
RUN pnpm --filter @workspace/edu-whiteboard run build

# Serve with nginx
FROM nginx:alpine
COPY --from=build /app/artifacts/edu-whiteboard/dist/public /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 5173
CMD ["nginx", "-g", "daemon off;"]
